# ==============================================================================
# FleetFlow Logistics Platform - Environment Configuration Template
# Milestone 4: Production Infrastructure Configuration
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=fleetflow_secure_password_2026
POSTGRES_DB=fleetflow_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:fleetflow_secure_password_2026@localhost:5432/fleetflow_db

# Redis & Celery Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security & JWT Authentication
SECRET_KEY=fleetflow_enterprise_production_jwt_secret_key_change_in_prod_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server & Network Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Notification Channel Gateway Configs (Optional external credentials)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
FCM_SERVER_KEY=your_firebase_cloud_messaging_key
